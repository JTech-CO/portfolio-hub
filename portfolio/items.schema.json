{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JTech Portfolio Items",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "name", "shortDescription", "shortDescriptionEn"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string", "minLength": 1 },
        "shortDescriptionEn": { "type": "string", "minLength": 1 },
        "fullDescription": { "type": "string" },
        "icon": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "status": {
          "enum": ["active", "beta", "coming-soon"]
        },
        "version": { "type": "string" },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "featured": { "type": "boolean" },
        "repoUrl": { "type": ["string", "null"] },
        "liveUrl": { "type": ["string", "null"] },
        "actionLabel": { "type": "string" },
        "actionLabelEn": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
